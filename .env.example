# Public frontend configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_REPORTS_ENABLED=true
VITE_AUTH_ENABLED=false

# Vercel server-only configuration (never prefix these with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APP_PROXY_SECRET=YOUR_SERVER_ONLY_PROXY_SECRET
DEFAULT_WORKBOOK_YEAR=2026
WORKBOOK_CONTEXTS_JSON={"2026":{"transport":"YOUR_TRANSPORT_SPREADSHEET_ID","cashflow":"YOUR_CASHFLOW_SPREADSHEET_ID"}}

# Candidate R8 maintenance gate; false unless a rollout window is approved
BUSINESS_WRITES_PAUSED=false
