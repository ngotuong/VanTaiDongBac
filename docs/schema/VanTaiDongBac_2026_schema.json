        "A2:E2": "Pulls date/month/vehicle/project/reported trips from NL_VanChuyen.",
        "F2": "=MAP(A2:A;C2:C;LAMBDA(ngay;xe;IF(ngay=\"\";\"\";SUMIFS(NL_TaiXe!E:E;NL_TaiXe!A:A;ngay;NL_TaiXe!C:C;xe))))",
        "G2": "=ARRAYFORMULA(IF(A2:A=\"\";\"\";E2:E-F2:F))",
        "H2": "=MAP(G2:G;LAMBDA(le;IF(le=\"\";\"\";IFS(le=0;\"Khớp\";le>0;\"Thiếu chuyến tài xế\";le<0;\"Tài xế khai dư\"))))",
        "I2": "=MAP(A2:A;C2:C;LAMBDA(ngay;xe;IF(ngay=\"\";\"\";COUNTUNIQUEIFS(NL_TaiXe!D:D;NL_TaiXe!A:A;ngay;NL_TaiXe!C:C;xe))))",
        "J2": "=MAP(A2:A;F2:F;I2:I;LAMBDA(ngay;ch;sl;IF(ngay=\"\";\"\";IF(ngay<DATE(2026;7;1);\"\";IFS((sl=1)*(ch>=5);\"Xe 1 lái vượt mốc 4 chuyến\";(sl>=2)*(ch>=7);\"Xe 2 lái vượt mốc 6 chuyến\";TRUE;\"\")))))",
        "K2": "=MAP(A2:A;F2:F;I2:I;J2:J;LAMBDA(ngay;ch;sl;dk;IF(ngay=\"\";\"\";IF(dk=\"\";0;IF(sl=1;MAX(0;ch-4);IF(sl>=2;MAX(0;ch-6);0))))))",
        "L2": "=ARRAYFORMULA(IF(A2:A=\"\";\"\";K2:K*200000))",
        "M2": "=MAP(A2:A;B2:B;C2:C;LAMBDA(ngay;thang;xe;IF(ngay=\"\";\"\";SUMIFS(F:F;B:B;thang;C:C;xe;A:A;\"<\"&ngay))))",
        "N2": "=MAP(A2:A;F2:F;M2:M;LAMBDA(ngay;ch;lk;IF(ngay=\"\";\"\";IF(ngay<DATE(2026;7;1);0;MAX(0;lk+ch-168)-MAX(0;lk-168)))))",
        "O2": "=ARRAYFORMULA(IF(A2:A=\"\";\"\";N2:N*XLOOKUP(\"THUONG_VUOT_168\";DM_ThamSo!A:A;DM_ThamSo!C:C)))",
        "P2": "=MAP(J2:J5000;N2:N5000;LAMBDA(dk;cvvuot;IF((dk=\"\")*(cvvuot=0);\"\";\"Có thưởng nóng cần kiểm tra và nhập Thu chi nếu đã chi\")))",
        "Q2": "=ARRAYFORMULA(IF(A2:A5000=\"\";\"\";L2:L5000+O2:O5000))"
