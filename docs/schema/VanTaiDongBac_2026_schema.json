        "K2": "=ARRAYFORMULA(IF(A2:A=\"\";\"\";XLOOKUP(\"MOC_KPI_CHUYEN\";DM_ThamSo!A:A;DM_ThamSo!C:C)-J2:J))",
        "L2": "=ARRAYFORMULA(IF(A2:A=\"\";\"\";I2:I))"
      }
