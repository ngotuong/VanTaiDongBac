{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next-shell/components/platform/**/*.ts",
    "next-shell/components/platform/**/*.tsx",
    "next-shell/components/report/**/*.tsx",
    "next-shell/components/dashboard/**/*.tsx",
    "next-shell/components/manage/**/*.tsx",
    "next-shell/components/entry/**/*.tsx",
    "next-shell/components/catalog/**/*.tsx",
    "next-shell/components/cashflow/**/*.tsx",
    "next-shell/components/settings/**/*.tsx",
    "next-shell/components/observability/**/*.tsx",
    "next-shell/lib/platform/**/*.ts",
    "next-shell/lib/report-server.ts",
    "next-shell/lib/dashboard-server.ts",
    "next-shell/lib/manage-server.ts",
    "next-shell/lib/entry-server.ts",
    "next-shell/lib/catalog-server.ts",
    "next-shell/lib/cashflow-server.ts",
    "next-shell/app/report-data/**/*.ts",
    "app/report-data/**/*.ts",
    "next-shell/app/dashboard-data/**/*.ts",
    "app/dashboard-data/**/*.ts",
    "next-shell/app/manage-data/**/*.ts",
    "app/manage-data/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
